module my_24to1_mux(
    input GN,          // 使能端，低电平有效（GN=0时工作）
    input [4:0] SEL,   // 5位选择端（仅使用0~23，对应SEL=00000~10111）
    input [23:0] D,    // 24路输入数据（D0~D23）
    output reg WN,     // 反相输出端
    output Y           // 原相输出端
);

always @(*) begin
    if (GN == 1'b0) begin  // 使能有效时
        case(SEL)
            // 选择0~23路输入（对应24路有效数据）
            5'b00000: WN = ~D[0];
            5'b00001: WN = ~D[1];
            5'b00010: WN = ~D[2];
            5'b00011: WN = ~D[3];
            5'b00100: WN = ~D[4];
            5'b00101: WN = ~D[5];
            5'b00110: WN = ~D[6];
            5'b00111: WN = ~D[7];
            5'b01000: WN = ~D[8];
            5'b01001: WN = ~D[9];
            5'b01010: WN = ~D[10];
            5'b01011: WN = ~D[11];
            5'b01100: WN = ~D[12];
            5'b01101: WN = ~D[13];
            5'b01110: WN = ~D[14];
            5'b01111: WN = ~D[15];
            5'b10000: WN = ~D[16];
            5'b10001: WN = ~D[17];
            5'b10010: WN = ~D[18];
            5'b10011: WN = ~D[19];
            5'b10100: WN = ~D[20];
            5'b10101: WN = ~D[21];
            5'b10110: WN = ~D[22];
            5'b10111: WN = ~D[23];
            // 超出24路的选择（SEL=11000~11111）视为无效，输出高电平
            default: WN = 1'b1;
        endcase
    end else begin  // 使能无效时，输出固定高电平
        WN = 1'b1;
    end
end

assign Y = ~WN;  // 原相输出（与反相输出WN逻辑相反）

endmodule